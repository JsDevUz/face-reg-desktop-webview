{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-face-reg-http",
  "description": "Faqat FaceReg remote frontendiga tayin API uchun HTTP ruxsati",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://face-reg-cyan.vercel.app/*",
      "https://*.vercel.app/*"
    ]
  },
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.tayin.uz/**"
        },
        {
          "url": "https://api.pharma-cosmos.uz:4443/**"
        }
      ]
    }
  ]
}